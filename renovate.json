{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "baseBranches": ["v2"],
  "packageRules": [
    {
      "description": "Next.js and React ship monthly security releases: patch updates merge fast",
      "matchPackageNames": ["next", "react", "react-dom"],
      "matchUpdateTypes": ["patch"],
      "groupName": "next and react patches"
    },
    {
      "description": "The sandbox must stay on PyTorch 2.14 + CUDA 12.6 while the GPU is Pascal (GTX 10xx)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["pytorch/pytorch"],
      "allowedVersions": "/^2\\.14\\./"
    },
    {
      "description": "TypeScript 7 has no compiler API yet; Next.js tooling needs 6.x",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
