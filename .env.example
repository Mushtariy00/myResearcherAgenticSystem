# Dev settings for the apps you run on the host (make api / worker / gateway / migrate / web).
# `make env` copies this to .env (git-ignored). The database password matches infra/compose/.env.
ARP_DATABASE_URL=postgresql+psycopg://arp:change-me-dev-only@127.0.0.1:5432/arp
ARP_VALKEY_URL=redis://127.0.0.1:6379/0
ARP_TEMPORAL_ADDRESS=127.0.0.1:7233
ARP_PUBLIC_ORIGIN=http://localhost:8080
# Where the API asks Better Auth (inside the Next.js app) to check session cookies.
ARP_AUTH_URL=http://127.0.0.1:3000
# Internal gateway that holds the OpenRouter keys; workers authenticate with this token.
ARP_GATEWAY_URL=http://127.0.0.1:8100
ARP_GATEWAY_TOKEN=dev-gateway-token-change-me
# Paste your OpenRouter key here. Free (:free) models work without credits.
ARP_OPENROUTER_API_KEY=

# Next.js / Better Auth (read by apps/web)
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080
AUTH_DATABASE_URL=postgres://arp:change-me-dev-only@127.0.0.1:5432/arp?options=-c%20search_path%3Dauth
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=no-reply@arp.local
