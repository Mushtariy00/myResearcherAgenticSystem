# Dev settings for the apps you run on the host (make api / worker / gateway / migrate / web).
# `make env` copies this to .env (git-ignored). The database password matches infra/compose/.env.
ARP_DATABASE_URL=postgresql+psycopg://arp:change-me-dev-only@127.0.0.1:5432/arp
ARP_VALKEY_URL=redis://127.0.0.1:6379/0
ARP_TEMPORAL_ADDRESS=127.0.0.1:7233
ARP_PUBLIC_ORIGIN=http://localhost:8080
# Where the API asks Better Auth (inside the Next.js app) to check session cookies.
ARP_AUTH_URL=http://127.0.0.1:3000
# Internal gateway that holds the OpenRouter keys; workers authenticate with this token.
ARP_GATEWAY_URL=http://127.0.0.1:8100
ARP_GATEWAY_TOKEN=dev-gateway-token-change-me
# Paste your OpenRouter key here. Free (:free) models work without credits.
ARP_OPENROUTER_API_KEY=
# Free tier per OpenRouter account: 50 requests/day, or 1,000/day after buying $10 of credits once.
# Each user's fair share of it can't exceed the lab-wide number (the gateway refuses to start).
ARP_FREE_REQUESTS_PER_DAY=50
ARP_FREE_REQUESTS_PER_USER_PER_DAY=20
# One /v1/complete call gives up after this many seconds, below the worker's 180 s client timeout.
ARP_COMPLETE_DEADLINE_SECONDS=150
# Optional model preferences, comma-separated. Models missing from OpenRouter's catalog are skipped.
ARP_FREE_MODELS=
ARP_PAID_MODELS=

# Literature stage (docs/design/literature.md). Files (PDFs) live under ARP_DATA_DIR, which is
# empty for ~/.local/share/arp, outside the repo, since the Next dev server watches the repo.
ARP_DATA_DIR=
# The contact in the scholarly APIs' User-Agent; Unpaywall needs a real email, or is skipped.
ARP_CONTACT_EMAIL=
# Optional free keys: OpenAlex gives about 100 searches a day without one (about 1,000 with),
# Semantic Scholar answers 429 without one, CORE is skipped without one.
ARP_OPENALEX_API_KEY=
ARP_S2_API_KEY=
ARP_CORE_API_KEY=
# PDF parsing: `docker compose -f infra/compose/compose.yaml --profile parse up -d grobid`.
ARP_GROBID_URL=http://127.0.0.1:8070

# Next.js / Better Auth (read by apps/web)
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080
AUTH_DATABASE_URL=postgres://arp:change-me-dev-only@127.0.0.1:5432/arp?options=-c%20search_path%3Dauth
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=no-reply@arp.local
