    "@tanstack/react-table": "9.3.1",
    "better-auth": "1.7.14",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "diff": "9.0.0",
    "echarts": "6.1.0",
    "katex": "0.19.1",
    "lucide-react": "1.63.0",
