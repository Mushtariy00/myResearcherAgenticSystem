    "@types/react-dom": "^19",
    "auth": "1.7.14",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
