{
  "name": "@agentic/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
