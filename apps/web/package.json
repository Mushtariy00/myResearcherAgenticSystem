    "gen:openapi": "sh scripts/dump-openapi.sh",
    "gen:client": "openapi-ts",
    "auth:migrate": "auth migrate --config src/lib/auth.ts --yes",
    "bootstrap-admin": "node scripts/bootstrap-admin.ts"
  },
