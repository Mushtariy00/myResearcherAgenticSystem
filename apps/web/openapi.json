  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "status": {
            "type": "string",
            "const": "accepted",
            "title": "Status",
            "default": "accepted"
          }
        },
        "type": "object",
        "title": "Accepted"
      },
      "BudgetIn": {
        "properties": {
          "monthly_usd": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Monthly Usd"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "monthly_usd"
        ],
        "title": "BudgetIn"
      },
      "BudgetOut": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "monthly_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Monthly Usd"
          },
          "spent_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Spent Usd"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "monthly_usd",
          "spent_usd"
        ],
        "title": "BudgetOut"
      },
      "Decision": {
        "type": "string",
        "enum": [
          "approve",
          "request_changes",
          "reject"
        ],
        "title": "Decision"
      },
      "DecisionIn": {
        "properties": {
          "stage_output_id": {
            "type": "string",
            "format": "uuid",
            "title": "Stage Output Id"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "comment": {
            "type": "string",
            "maxLength": 5000,
            "title": "Comment",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stage_output_id",
          "sha256",
          "decision"
        ],
        "title": "DecisionIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "environment"
        ],
        "title": "HealthResponse"
      },
      "LlmPolicy": {
        "type": "string",
        "enum": [
          "auto",
          "free"
        ],
        "title": "LlmPolicy"
      },
      "MeOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "budget_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Budget Usd"
          },
          "spent_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Spent Usd"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role",
          "budget_usd",
          "spent_usd"
        ],
        "title": "MeOut"
      },
      "MemberAdd": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email"
          },
          "role": {
            "$ref": "#/components/schemas/ProjectRole"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "role"
        ],
        "title": "MemberAdd"
      },
      "MemberOut": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/ProjectRole"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "email",
          "name",
          "role"
        ],
        "title": "MemberOut"
      },
      "PaidModelsSetting": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "PaidModelsSetting"
      },
      "Privacy": {
        "type": "string",
        "enum": [
          "standard",
          "confidential"
        ],
        "title": "Privacy"
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ProjectCreate"
      },
      "ProjectOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "privacy": {
            "$ref": "#/components/schemas/Privacy"
          },
          "allow_free_models": {
            "type": "boolean",
            "title": "Allow Free Models"
          },
          "created_by": {
            "type": "string",
            "title": "Created By"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "my_role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectRole"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "privacy",
          "allow_free_models",
          "created_by",
          "created_at"
        ],
        "title": "ProjectOut"
      },
      "ProjectRole": {
        "type": "string",
        "enum": [
          "owner",
          "researcher",
          "viewer"
        ],
        "title": "ProjectRole"
      },
      "RunCreate": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Topic"
          },
          "llm_policy": {
            "$ref": "#/components/schemas/LlmPolicy",
            "default": "auto"
          },
          "budget_cap_usd": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Cap Usd"
          }
        },
